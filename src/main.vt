import math;
import text;
class Fraction {
    long num;   
    long den;   
    def init(self, n, d) {
        if (d == 0) {
            raise ValueError("Fraction: denominator must not be zero");
        }
        long a = n;
        long b = d;
        if (b < 0) { a = -a; b = -b; }
        long g = math.gcd(a, b);
        if (g < 0) { g = -g; }
        if (g > 1) {
            a = a / g;
            b = b / g;
        }
        self.num = a;
        self.den = b;
    }
    def to_float(self) {
        return float(self.num) / float(self.den);
    }
    def to_str(self) {
        if (self.den == 1) {
            return str(self.num);
        }
        return str(self.num) + "/" + str(self.den);
    }
    
    def add(self, other) {
        return Fraction(self.num * other.den + other.num * self.den,
                        self.den * other.den);
    }
    def sub(self, other) {
        return Fraction(self.num * other.den - other.num * self.den,
                        self.den * other.den);
    }
    def mul(self, other) {
        return Fraction(self.num * other.num, self.den * other.den);
    }
    def div(self, other) {
        if (other.num == 0) {
            raise ZeroDivisionError("Fraction: division by zero");
        }
        return Fraction(self.num * other.den, self.den * other.num);
    }
    
    def neg(self) { return Fraction(-self.num, self.den); }
    def abs(self) {
        if (self.num < 0) {
            return Fraction(-self.num, self.den);
        }
        return Fraction(self.num, self.den);
    }
    def inv(self) {
        if (self.num == 0) {
            raise ZeroDivisionError("Fraction: inverse of zero");
        }
        return Fraction(self.den, self.num);
    }
    
    def pow(self, n) {
        if (n < 0) {
            return self.inv().pow(-n);
        }
        Fraction result = Fraction(1, 1);
        Fraction base   = Fraction(self.num, self.den);
        long e = n;
        while (e > 0) {
            if ((e & 1) == 1) {
                result = result.mul(base);
            }
            base = base.mul(base);
            e = e >> 1;
        }
        return result;
    }
    
    def eq(self, other) {
        return self.num == other.num && self.den == other.den;
    }
    def ne(self, other) { return !self.eq(other); }
    def lt(self, other) {
        return self.num * other.den < other.num * self.den;
    }
    def le(self, other) {
        return self.num * other.den <= other.num * self.den;
    }
    def gt(self, other) {
        return self.num * other.den > other.num * self.den;
    }
    def ge(self, other) {
        return self.num * other.den >= other.num * self.den;
    }
    def cmp(self, other) {
        long l = self.num * other.den;
        long r = other.num * self.den;
        if (l < r) { return -1; }
        if (l > r) { return  1; }
        return 0;
    }
}
def frac(n, d) { return Fraction(n, d); }
def from_int(n) { return Fraction(n, 1); }
def from_float(x) { return from_float_prec(x, 6); }
def from_float_prec(x, prec) {
    double scale = 1.0;
    long i = 0;
    while (i < prec) { scale = scale * 10.0; i = i + 1; }
    long n = long(x * scale);
    return Fraction(n, long(scale));
}
def parse(s) {
    int idx = text.find(s, "/");
    if (idx < 0) {
        return Fraction(long(text.trim(s)), 1);
    }
    str left  = "";
    str right = "";
    long n = text.len(s);
    long i = 0;
    while (i < idx) {
        left = left + text.char_at(s, i);
        i = i + 1;
    }
    i = idx + 1;
    while (i < n) {
        right = right + text.char_at(s, i);
        i = i + 1;
    }
    return Fraction(long(text.trim(left)), long(text.trim(right)));
}
def to_str(f)   { return f.to_str(); }
def to_float(f) { return f.to_float(); }
def numerator(f)   { return f.num; }
def denominator(f) { return f.den; }
def add(a, b) { return a.add(b); }
def sub(a, b) { return a.sub(b); }
def mul(a, b) { return a.mul(b); }
def div(a, b) { return a.div(b); }
def neg(a)  { return a.neg(); }
def abs_(a) { return a.abs(); }
def inv(a)  { return a.inv(); }
def pow(a, n) { return a.pow(n); }
def add_int(a, k) { return a.add(Fraction(k, 1)); }
def sub_int(a, k) { return a.sub(Fraction(k, 1)); }
def mul_int(a, k) { return a.mul(Fraction(k, 1)); }
def div_int(a, k) { return a.div(Fraction(k, 1)); }
def eq(a, b) { return a.eq(b); }
def ne(a, b) { return a.ne(b); }
def lt(a, b) { return a.lt(b); }
def le(a, b) { return a.le(b); }
def gt(a, b) { return a.gt(b); }
def ge(a, b) { return a.ge(b); }
def cmp(a, b) { return a.cmp(b); }
global ZERO = Fraction(0, 1);
global ONE  = Fraction(1, 1);
Fraction operator Fraction a + Fraction b { return a.add(b); }
Fraction operator Fraction a - Fraction b { return a.sub(b); }
Fraction operator Fraction a * Fraction b { return a.mul(b); }
Fraction operator Fraction a / Fraction b { return a.div(b); }
Fraction operator - Fraction a           { return a.neg(); }